{
  "name": "network_sweep",
  "description": "Full network sweep: host discovery, port scan, OS detection, service enumeration across a subnet.",
  "author": "james-linux",
  "version": "1.0",
  "requires_root": true,
  "steps": [
    {
      "id": "ping_sweep",
      "action": "nmap.scan",
      "params": {
        "target": "{{subnet}}",
        "flags": "-sn",
        "sudo": true
      },
      "description": "Ping sweep to discover live hosts on the subnet"
    },
    {
      "id": "port_scan",
      "action": "nmap.scan",
      "params": {
        "target": "{{subnet}}",
        "flags": "-T4 -F -sV",
        "sudo": true
      },
      "description": "Fast scan of top 100 ports with version detection"
    },
    {
      "id": "os_fingerprint",
      "action": "nmap.scan",
      "params": {
        "target": "{{subnet}}",
        "flags": "-O --osscan-guess",
        "sudo": true
      },
      "description": "OS fingerprinting across discovered hosts"
    },
    {
      "id": "nbtscan",
      "action": "layer.run",
      "params": {
        "command": "nbtscan {{subnet}}",
        "timeout": 60
      },
      "description": "NetBIOS name scan for Windows host discovery"
    }
  ]
}
