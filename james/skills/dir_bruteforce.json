{
  "name": "dir_bruteforce",
  "description": "Web directory and file bruteforce using gobuster and dirb.",
  "author": "james-linux",
  "version": "1.0",
  "requires_root": false,
  "steps": [
    {
      "id": "gobuster_dirs",
      "action": "layer.run",
      "params": {
        "command": "gobuster dir -u {{target_url}} -w /usr/share/wordlists/dirb/common.txt -t 30 -o /tmp/james_gobuster.txt --no-error -q",
        "timeout": 300
      },
      "description": "Gobuster directory brute-force with common wordlist"
    },
    {
      "id": "gobuster_extended",
      "action": "layer.run",
      "params": {
        "command": "gobuster dir -u {{target_url}} -w /usr/share/wordlists/dirbuster/directory-list-2.3-medium.txt -t 30 -x php,html,txt,bak,old,zip -o /tmp/james_gobuster_ext.txt --no-error -q",
        "timeout": 600
      },
      "description": "Extended brute-force with file extensions (.php, .html, .txt, .bak, .zip)"
    }
  ],
  "category": "web"
}
