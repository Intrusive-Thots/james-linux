{
    "name": "wpa3_assessment",
    "description": "WPA3/SAE security assessment: detect SAE support, check for transition mode, attempt downgrade attack",
    "author": "JAMES",
    "version": "1.0",
    "category": "wifi",
    "tags": ["wpa3", "sae", "dragonblood", "downgrade", "wireless"],
    "requires": ["aircrack-ng", "iw"],
    "variables": {
        "interface": "monitor-mode interface",
        "bssid": "target AP BSSID",
        "channel": "target AP channel"
    },
    "steps": [
        {
            "tool": "wpa3",
            "action": "check_sae_support",
            "params": {"interface": "{{interface}}", "bssid": "{{bssid}}"},
            "description": "Check if target supports SAE/WPA3"
        },
        {
            "tool": "wpa3",
            "action": "downgrade_attack",
            "params": {"interface": "{{interface}}", "bssid": "{{bssid}}", "channel": "{{channel}}"},
            "description": "Attempt WPA3 transition mode downgrade to capture WPA2 handshake",
            "condition": "previous.transition_mode == true"
        }
    ]
}
