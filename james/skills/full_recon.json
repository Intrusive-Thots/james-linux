{
  "name": "full_recon",
  "description": "Full network reconnaissance: quick scan, then deep service/version detection on discovered hosts.",
  "author": "james-linux",
  "version": "1.0",
  "requires_root": false,
  "steps": [
    {
      "id": "quick_scan",
      "action": "nmap.quick_scan",
      "params": {"target": "{{target}}"},
      "description": "Fast top-100 port scan to discover live hosts"
    },
    {
      "id": "service_scan",
      "action": "nmap.scan",
      "params": {
        "target": "{{target}}",
        "flags": "-sV -sC -A",
        "ports": "{{ports}}"
      },
      "description": "Deep service version and script scan"
    },
    {
      "id": "os_detection",
      "action": "nmap.os_detect",
      "params": {"target": "{{target}}"},
      "description": "OS fingerprinting (requires root)"
    }
  ]
}
