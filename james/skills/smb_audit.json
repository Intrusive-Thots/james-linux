{
  "name": "smb_audit",
  "description": "Automated SMB enumeration: nmap SMB scripts and enum4linux.",
  "author": "james-linux",
  "version": "1.0",
  "requires_root": false,
  "steps": [
    {
      "id": "smb_nmap",
      "action": "nmap.scan",
      "params": {
        "target": "{{target}}",
        "flags": "--script smb-enum-shares.nse,smb-enum-users.nse,smb-os-discovery.nse",
        "ports": "139,445"
      },
      "description": "Run nmap SMB enumeration scripts"
    },
    {
      "id": "enum4linux",
      "action": "layer.run",
      "params": {
        "command": "enum4linux -a {{target}}",
        "timeout": 300
      },
      "description": "Run enum4linux for deeper SMB extraction"
    }
  ]
}
