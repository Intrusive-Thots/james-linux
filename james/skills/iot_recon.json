{
    "name": "iot_recon",
    "description": "IoT device reconnaissance: banner grab, mDNS discovery, BLE scan, and MQTT broker probe",
    "author": "JAMES",
    "version": "1.0",
    "category": "iot",
    "tags": ["iot", "mqtt", "ble", "bluetooth", "smart-home", "upnp", "mdns"],
    "requires": ["nmap", "mosquitto-clients", "avahi-utils"],
    "variables": {
        "target": "target IP or subnet (e.g. 192.168.1.0/24)"
    },
    "steps": [
        {
            "tool": "iot",
            "action": "banner_grab",
            "params": {"target": "{{target}}"},
            "description": "IoT port fingerprinting (21,23,80,1883,5683,8080,8883)"
        },
        {
            "tool": "iot",
            "action": "scan_mdns",
            "description": "Discover mDNS/Bonjour services on the LAN"
        },
        {
            "tool": "iot",
            "action": "scan_upnp",
            "description": "Discover UPnP/SSDP devices"
        },
        {
            "tool": "iot",
            "action": "scan_mqtt",
            "params": {"target": "{{target}}"},
            "description": "Probe MQTT broker for open access"
        },
        {
            "tool": "iot",
            "action": "scan_ble",
            "description": "Scan for nearby Bluetooth LE devices"
        }
    ]
}
