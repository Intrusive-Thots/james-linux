{
  "name": "web_recon",
  "description": "Automated Web Reconnaissance: nmap HTTP scripts and nikto vulnerability scan.",
  "author": "james-linux",
  "version": "1.0",
  "requires_root": false,
  "steps": [
    {
      "id": "http_nmap",
      "action": "nmap.scan",
      "params": {
        "target": "{{target}}",
        "flags": "--script http-enum,http-title,http-headers",
        "ports": "{{port}}"
      },
      "description": "Run nmap HTTP enumeration scripts"
    },
    {
      "id": "nikto_scan",
      "action": "layer.run",
      "params": {
        "command": "nikto -h http://{{target}}:{{port}}",
        "timeout": 600
      },
      "description": "Run Nikto web vulnerability scanner"
    }
  ],
  "category": "web"
}
